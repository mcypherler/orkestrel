# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
APP_URL=http://127.0.0.1:3000

# Session & encryption
SESSION_SECRET=generate-random-32-bytes
TOKEN_ENCRYPTION_KEY=generate-random-32-bytes-base64

# Spotify
SPOTIFY_API_CLIENTID=your-spotify-client-id
SPOTIFY_API_SECRET=your-spotify-client-secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/spotify/callback
SPOTIFY_SCOPES=user-top-read user-read-recently-played

# Ticketmaster
TICKETMASTER_API_KEY=your-ticketmaster-consumer-key

# WhatsApp / Twilio
WHATSAPP_PROVIDER=console
TWILLIO_API_CLIENTID=your-twilio-account-sid
TWILLIO_API_SECRET=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_RECIPIENT=whatsapp:+44...

# Alerts
ALERTS_ENABLED=false

# OpenAI (for AI matching + semantic taste matching)
OPENAI_API_SECRET=your-openai-api-key

# Semantic matching (off | shadow | ranked | notify)
SEMANTIC_MATCHING_MODE=off

# Cron
CRON_SECRET=generate-random-32-bytes
